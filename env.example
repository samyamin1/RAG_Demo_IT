# Ollama Configuration
OLLAMA_MODEL=llama3:8b
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text

# Storage Directories
CHROMA_DIR=.chroma
BM25_DIR=.bm25
DATA_DIR=data

# Retrieval Parameters
TOP_K=5
VECTOR_TOP_K=10
BM25_TOP_K=20
RRF_K=60

# BM25 Parameters
BM25_K1=1.5
BM25_B=0.75

# Chunking Parameters
CHUNK_SIZE=800
CHUNK_OVERLAP=120
SPLITTER=recursive

# LLM Generation Parameters
TEMPERATURE=0.2
MAX_CONTEXT_TOKENS=6000
MAX_OUTPUT_TOKENS=1024

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000

# Evaluation
EVAL_EPOCHS=3


